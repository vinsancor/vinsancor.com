# Segurança - HSTS e Headers HTTP
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Forçar HTTPS e Redirecionar www para não-www
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Redirecionar HTTP para HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # Redirecionar www para não-www
    RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    # Redirecionar o endereço antigo da página de criação de sites.
    RewriteRule ^criacao-sites-one-page\.html$ /criacao-sites-que-vendem-mais.html [R=301,L]

    # URLs antigas das postagens do blog: redirecionamento permanente para os HTML publicados na raiz.
    RewriteRule ^blog/como-dominar-avaliacoes-google-transformar-estrelas-em-vendas/?$ /como-dominar-avaliacoes-google-transformar-estrelas-em-vendas.html [R=301,L]
    RewriteRule ^blog/guia-completo-marketing-para-bares-e-restaurantes/?$ /guia-completo-marketing-para-bares-e-restaurantes.html [R=301,L]
    RewriteRule ^blog/como-criar-um-cardapio-rentavel-e-atraente/?$ /como-criar-um-cardapio-rentavel-e-atraente.html [R=301,L]
</IfModule>


# Página 404 personalizada (One Page força a Home)
ErrorDocument 404 /index.html

# Compressão gzip/deflate
<IfModule mod_deflate.c>
    # Adicionar saída comprimida para os seguintes tipos
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache de Navegador (Headers)
<IfModule mod_headers.c>
    # NUNCA fazer cache do HTML
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # URLs de assets locais levam ?v=20260929. Ao publicar uma nova versão de um asset,
    # atualize o parâmetro v nas páginas para invalidar imediatamente o cache anterior.
    # Com URLs versionadas, arquivos estáticos podem ser armazenados por um ano.
    <FilesMatch "(?i)\.(jpg|jpeg|png|gif|webp|avif|ico|svg|css|js|mjs|woff|woff2|ttf|otf|eot|mp4|webm|mp3|ogg|pdf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
